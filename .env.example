# Local defaults match docker-compose.yml. Real credentials never go in git.
DATABASE_URL=postgresql+psycopg://shopwright:shopwright@localhost:5432/shopwright
REDIS_URL=redis://localhost:6379/0

# Public base URL of this API (OAuth redirect target)
APP_URL=http://localhost:8000
# Comma-separated browser origins allowed to call the API; * is fine with bearer tokens.
CORS_ORIGINS=*

# Shopify app credentials — Partner dashboard → your app → API keys
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Fernet key encrypting store access tokens at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Embeddings for retrieval. Empty uses a local hashing embedder (dev and tests only).
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5

ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
# USD per million tokens, from Anthropic pricing; 0 shows tokens only on the dashboard.
AGENT_INPUT_USD_PER_MTOK=0
AGENT_OUTPUT_USD_PER_MTOK=0

# Signs widget tokens. Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
WIDGET_TOKEN_SECRET=
